{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Friction",
  "version": "0.1.0",
  "identifier": "com.friction.firewall",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Friction",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "main-capability"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "copyright": "\u00a9 2026 Shane",
    "shortDescription": "Local AI firewall for autonomous agents",
    "longDescription": "Friction sits between your AI agents and the internet. It inspects every request on your Mac, blocks hidden fees, over-budget charges and prompt-injected instructions, and asks you before anything risky goes through.",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "resources": {
      "../cli/friction": "friction"
    }
  }
}
